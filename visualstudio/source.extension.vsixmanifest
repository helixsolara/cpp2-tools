<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Id="Cpp2.VisualStudio.4adfc9ce-db31-4fb7-951a-3fef28806ac7" Version="0.5.1" Language="en-US" Publisher="helixsolara" />
    <DisplayName>Cpp2</DisplayName>
    <Description xml:space="preserve">Syntax highlighting for Cpp2 (cppfront) .cpp2 and .h2 files, commands that transpile a file as its CMake build would, open its generated code, and build and run a single file, and MSBuild support for .cpp2 files in C++ projects.</Description>
    <MoreInfo>https://github.com/helixsolara/cpp2-tools</MoreInfo>
    <License>LICENSE</License>
    <Tags>cpp2, cppfront, C++</Tags>
  </Metadata>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.14,19.0)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.14,19.0)">
      <ProductArchitecture>arm64</ProductArchitecture>
    </InstallationTarget>
  </Installation>
  <Prerequisites>
    <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor" Version="[17.14,19.0)" DisplayName="Visual Studio core editor" />
  </Prerequisites>
  <Assets>
    <Asset Type="Microsoft.VisualStudio.VsPackage" d:Source="File" Path="Cpp2.pkgdef" />
    <Asset Type="Microsoft.VisualStudio.VsPackage" d:Source="Project" d:ProjectName="%CurrentProject%" Path="|%CurrentProject%;PkgdefProjectOutputGroup|" />
  </Assets>
</PackageManifest>
